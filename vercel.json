{
  "trailingSlash": true,
  "redirects": [
    { "source": "/python", "destination": "/python-for-data-science/", "permanent": true },
    { "source": "/python/(.*)", "destination": "/python-for-data-science/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:path((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
